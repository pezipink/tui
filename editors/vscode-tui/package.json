{
  "name": "tui-metadata",
  "displayName": "Tui metadata",
  "description": "Completion and member browsing for Tui modules, from the compiler's own expansion and CLR metadata.",
  "version": "0.1.0",
  "publisher": "pezipink",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./extension.js",
  "extensionDependencies": [
    "ms-dotnettools.csharp"
  ],
  "activationEvents": [
    "onLanguage:racket",
    "onCommand:tui.browse",
    "onDebugResolve:tui"
  ],
  "contributes": {
    "commands": [
      {
        "command": "tui.browse",
        "title": "Tui: Browse Members"
      }
    ],
    "breakpoints": [
      {
        "language": "racket"
      }
    ],
    "debuggers": [
      {
        "type": "tui",
        "label": "Tui",
        "languages": [
          "racket"
        ],
        "configurationAttributes": {
          "launch": {
            "properties": {
              "source": {
                "type": "string",
                "description": "The .tui file to build and debug. Defaults to the active editor.",
                "default": "${file}"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Command-line arguments for the program.",
                "default": []
              },
              "console": {
                "type": "string",
                "enum": [
                  "internalConsole",
                  "integratedTerminal",
                  "externalTerminal"
                ],
                "default": "internalConsole"
              },
              "stopAtEntry": {
                "type": "boolean",
                "default": false
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "name": "Debug Tui program",
            "type": "tui",
            "request": "launch",
            "source": "${file}"
          }
        ]
      }
    ],
    "configuration": {
      "title": "Tui",
      "properties": {
        "tui.racketPath": {
          "type": "string",
          "default": "racket",
          "description": "The racket executable that runs the metadata helper."
        },
        "tui.metaServerPath": {
          "type": "string",
          "default": "",
          "description": "The path to private/meta-server.rkt in the Tui repository. Leave empty to find it in the workspace folders."
        }
      }
    }
  },
  "scripts": {
    "test": "node --test test/syntax.test.js test/helper.test.js test/completion.test.js test/debug.test.js test/extension.test.js"
  }
}
